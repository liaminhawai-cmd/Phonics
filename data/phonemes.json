    { "id": "j",  "type": "consonant", "label": "/j/ as in jam", "ipa": {"au": "dʒ", "uk": "dʒ", "us": "dʒ"}, "articulation": {"place": "Post-alveolar", "manner": "affricate", "voiced": true}, "examples": ["jam", "gem", "bridge"], "recording": {"filename": "j.mp3", "legacy_sounds_folder": "dʒ ([j]am)"} },
    { "id": "f",  "type": "consonant", "label": "/f/ as in fish", "ipa": {"au": "f", "uk": "f", "us": "f"}, "articulation": {"place": "Labio-dental", "manner": "fricative", "voiced": false}, "examples": ["fish", "if", "phone", "cliff"], "recording": {"filename": "f.mp3", "legacy_sounds_folder": "f ([f]ish)"} },
    { "id": "v",  "type": "consonant", "label": "/v/ as in van", "ipa": {"au": "v", "uk": "v", "us": "v"}, "articulation": {"place": "Labio-dental", "manner": "fricative", "voiced": true}, "examples": ["van", "very", "have"], "recording": {"filename": "v.mp3", "legacy_sounds_folder": "v ([v]ery)"} },
    { "id": "th", "type": "consonant", "label": "/th/ (quiet) as in thin", "ipa": {"au": "θ", "uk": "θ", "us": "θ"}, "articulation": {"place": "Dental", "manner": "fricative", "voiced": false}, "examples": ["thin", "bath", "maths"], "recording": {"filename": "th.mp3", "legacy_sounds_folder": "θ ([th]in)"} },
    { "id": "dh", "type": "consonant", "label": "/th/ (noisy) as in this", "ipa": {"au": "ð", "uk": "ð", "us": "ð"}, "articulation": {"place": "Dental", "manner": "fricative", "voiced": true}, "examples": ["this", "that", "mother"], "recording": {"filename": "dh.mp3", "legacy_sounds_folder": "ð ([th]is)"} },
