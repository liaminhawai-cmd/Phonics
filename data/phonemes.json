    { "id": "g",  "type": "consonant", "label": "/g/ as in go", "ipa": {"au": "g", "uk": "g", "us": "g"}, "articulation": {"place": "Velar", "manner": "stop", "voiced": true}, "examples": ["go", "bag", "guess"], "recording": {"filename": "g.mp3", "legacy_sounds_folder": "g ([g]o)"} },
