{
  "$schema": "./schema/phonemes.schema.json",
  "comment": "The 44 phonemes of English as taught in synthetic phonics, keyed by stable ASCII ids that double as recording filenames. IPA given per accent: au = Australian English (Mitchell/Harrington broad transcription per australianlinguistics.com, matching this repo's sounds/ folders), uk = SSB (RP-derived), us = General American. Articulation place names match anatomy.js SPOTS keys so the mouth cutaway can be driven straight from this file.",
  "phonemes": [
    { "id": "p",  "type": "consonant", "label": "/p/ as in pen", "ipa": {"au": "p", "uk": "p", "us": "p"}, "articulation": {"place": "Bilabial", "manner": "stop", "voiced": false}, "examples": ["pen", "map", "happy"], "recording": {"filename": "p.mp3", "legacy_sounds_folder": "p ([p]en)"} },
    { "id": "b",  "type": "consonant", "label": "/b/ as in bed", "ipa": {"au": "b", "uk": "b", "us": "b"}, "articulation": {"place": "Bilabial", "manner": "stop", "voiced": true}, "examples": ["bed", "rib", "rabbit"], "recording": {"filename": "b.mp3", "legacy_sounds_folder": "b ([b]ed)"} },
    { "id": "t",  "type": "consonant", "label": "/t/ as in ten", "ipa": {"au": "t", "uk": "t", "us": "t"}, "articulation": {"place": "Alveolar", "manner": "stop", "voiced": false}, "examples": ["ten", "sit", "butter"], "notes": "US flaps medial t (butter) — realisation only, same phoneme.", "recording": {"filename": "t.mp3", "legacy_sounds_folder": "t ([t]wo)"} },
    { "id": "d",  "type": "consonant", "label": "/d/ as in dog", "ipa": {"au": "d", "uk": "d", "us": "d"}, "articulation": {"place": "Alveolar", "manner": "stop", "voiced": true}, "examples": ["dog", "lid", "ladder"], "recording": {"filename": "d.mp3", "legacy_sounds_folder": "d ([d]o)"} },
