  "families": {
    "anticlockwise-loop": { "letters": ["c", "o", "a", "d", "g", "q", "e"], "teach": "Start at 2 o'clock, curve up and over to the left — c is the mother shape; a, d, g, q are c plus a stick or tail, and e is c with a flat start across the middle.", "order": ["c", "o", "a", "d", "g", "q", "e"] },
    "tall-sticks": { "letters": ["l", "t", "b", "h", "k", "d", "f", "j"], "teach": "Start at the top line, pull straight down to the baseline.", "order": ["l", "t", "i", "h", "b", "k", "f"] },
    "tails": { "letters": ["g", "j", "p", "q", "y"], "teach": "The tail dives below the baseline; g, j and y hook left, q hooks right, p drops straight.", "order": ["j", "y", "g", "p", "q"] },
    "humps": { "letters": ["r", "n", "m", "h", "p"], "teach": "Down, retrace back up, over the hump.", "order": ["n", "m", "r", "h", "p"] },
    "u-turns": { "letters": ["i", "u", "y"], "teach": "Down to the baseline, curve round the bottom, back up to the dotted line, then straight down again — i is one leg, u is two, y adds the tail.", "order": ["i", "u", "y"] },
    "zigzags": { "letters": ["v", "w", "x", "z", "k"], "teach": "Straight lines with sharp changes of direction.", "order": ["v", "w", "z", "x", "k"] },
    "snake-curves": { "letters": ["s", "f"], "teach": "The two letters that change direction mid-stroke: s snakes back on itself, f curves over the top then drops straight down.", "order": ["s", "f"] },
    "digits-round": { "letters": ["0", "2", "3", "5", "6", "8", "9"], "teach": "Numbers start at the top line and sit on the baseline; the round ones all begin with the same over-the-top curve to the left.", "order": ["0", "6", "9", "2", "3", "5", "8"] },
    "digits-straight": { "letters": ["1", "4", "7"], "teach": "Numbers built from straight lines: start at the top, pull down, no exit hooks.", "order": ["1", "7", "4"] }
  }
}
